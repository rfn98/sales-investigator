{
  "name": "ai-business-investigator",
  "version": "0.1.0",
  "private": true,
  "description": "Detect abnormal business performance, identify evidence-based causes, and use AI to explain investigations and recommend actions.",
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "scripts": {
    "db:generate": "npx prisma generate",
    "db:migrate": "npx prisma migrate dev",
    "db:seed": "npx prisma db seed",
    "db:validate": "npx tsx prisma/validate.ts",
    "db:reset": "npx prisma migrate reset",
    "db:studio": "npx prisma studio",
    "investigate": "npx tsx scripts/investigate.ts",
    "analytics:audit": "npx tsx scripts/audit.ts",
    "ai:preview": "node --env-file-if-exists=.env --import tsx scripts/preview-ai-investigation.ts",
    "test:ai": "npx tsx --test scripts/ai-investigator.test.ts",
    "ai:openai:integration": "node --env-file-if-exists=.env --import tsx scripts/ai-openai.integration.ts",
    "smoke": "node scripts/smoke.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "next": "^16.3.4",
    "node-fetch": "^2.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "postcss": "^8.5.28",
    "prisma": "^6.5.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
