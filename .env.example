# AI Investigator — provider configuration template.
# Copy to .env and fill in values. Never commit the real .env.

# Provider selection for `npm run ai:preview`:
#   none   -> offline/deterministic (default, never calls an LLM)
#   openai -> calls the OpenAI-compatible endpoint below
AI_PROVIDER=none

# Local 9Router / OpenAI-compatible endpoint (override if needed).
OPENAI_BASE_URL=http://localhost:20128/v1

# Model served by 9Router (required when AI_PROVIDER=openai).
OPENAI_MODEL=combo-untuk-coding-auto-with-image

# Bearer token for the endpoint (required when AI_PROVIDER=openai;
# any placeholder value is accepted by the local 9Router).
OPENAI_API_KEY=

# Structured-output mode. Default off: no response_format field is sent,
# JSON structure is enforced by the validation layer.
OPENAI_JSON_MODE=off

# Timeout for a single LLM call, in milliseconds.
OPENAI_TIMEOUT_MS=60000

# Sampling temperature (0 = deterministic).
OPENAI_TEMPERATURE=0